# ============================================
# RR Procedure — 环境变量配置
# 复制此文件为 .env 并填写真实值
# ============================================

# ---- 飞书自建应用（从飞书开放平台获取） ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ---- 飞书多维表格 ----
# BITABLE_APP_TOKEN: 从多维表格 URL 中获取（https://xxx.feishu.cn/base/APP_TOKEN?...）
# 各表的 table_id 也在 URL 中：https://xxx.feishu.cn/base/APP_TOKEN/table/TABLE_ID
# 也可运行 python setup_bitable.py 自动创建
BITABLE_APP_TOKEN=
EMPLOYEES_TABLE_ID=
ROUNDS_TABLE_ID=
BALANCES_TABLE_ID=
STARWALL_TABLE_ID=

# ---- 数据库 ----
DB_PATH=rr.db

# ---- Session ----
# 生产环境务必改为随机字符串（可用 openssl rand -hex 32 生成）
SESSION_SECRET=change-me-in-production

# ---- Coin 业务规则（可按需调整） ----
MAX_COINS_ALLOCATED=20
MAX_COINS_PER_PAIR=3
