# 飞书应用配置（从飞书开放平台获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格 — App Token（从多维表格 URL 中获取）
BITABLE_APP_TOKEN=bascnxxxxxxxxxxxxxxxx

# 员工花名册表 ID（现有表格）
EMPLOYEES_TABLE_ID=tblxxxxxxxxxxxxxxxx

# 以下三张表需要新建（见 docs/bitable-schema.md）
ROUNDS_TABLE_ID=
BALANCES_TABLE_ID=
STARWALL_TABLE_ID=

# SQLite 数据库文件路径
DB_PATH=rr.db

# Session 加密密钥（生产环境务必修改为随机字符串）
SESSION_SECRET=change-me-in-production

# 超级管理员飞书 open_id（支持逗号分隔多个）
# SUPER_ADMINS 在 settings.py 中直接配置
